# Modelo de configuração / Configuration template
#
# O servidor não lê arquivos .env sozinho: estas são as variáveis que ele
# espera encontrar no ambiente. Nada aqui é obrigatório para rodar a demo.
#
# The server does not read .env files by itself: these are the variables it
# expects in the environment. None of them are required to run the demo.

# Porta / Port
PORT=3000

# Onde gravar os JSON / Where to store the JSON files.
# Em hospedagem, aponte para um disco persistente.
# On a hosting platform, point this to a persistent disk.
DATA_DIR=./data

# Ligue com 1 SOMENTE quando houver um proxy HTTPS na frente.
# Set to 1 ONLY when an HTTPS proxy sits in front of the app.
TRUST_PROXY=0

# Endereços do painel / Panel routes.
# A demo usa /caixa e /admin. Em produção, use algo que ninguém adivinhe.
# The demo uses /caixa and /admin. In production, pick something unguessable.
ROTA_CAIXA=caixa
ROTA_ADMIN=admin
